#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
        {
            for dir in "$HOME/Projects" "$HOME/vpn" "/etc/nixos" "$HOME/.dotfiles" ; do
                if [[ -d $dir ]]; then
                    find "$dir" -mindepth 1 -maxdepth 1
                fi
            done

            if [[ -d $HOME/.dotfiles ]]; then
                printf '%s\n' "$HOME/.dotfiles"
            fi
        } | fzf
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

# If selected is a file, get its parent directory
if [[ -f $selected ]]; then
    selected=$(dirname "$selected")
fi

selected_name=$(basename "$selected" | tr . _)

# Use exact tmux targets (=session) so sessions with shared prefixes
# (e.g. "foo" and "foobar") don't match the wrong session.
if ! tmux has-session -t "=$selected_name" 2> /dev/null; then
    tmux new-session -d -s "$selected_name" -n 'bash' -c "$selected" 'bash'
      # tmux new-window -t "=$selected_name" -n 'git' -c "$selected"
      # tmux new-window -t "=$selected_name" -n 'codex' -c "$selected"
      # tmux send-keys -t "=$selected_name:codex" 'pi' Enter
      # tmux select-window -t "=$selected_name:jj"
      # tmux new-window -t "=$selected_name" -n 'bash' -c "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t "=$selected_name"
else
    tmux switch-client -t "=$selected_name"
fi
