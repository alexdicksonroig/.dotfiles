[alias]
    undo = reset --soft HEAD^
    ignore = update-index --skip-worktree
    unignore = update-index --no-skip-worktree
    s = status
    ds = diff --staged
    d = diff
    stashy = git stash push -u --keep-index
    ac = "!f() { git add . && git commit -m \"$1\"; }; f"
    acp = "!f() { git add . && git commit -m \"$1\" && git push -f; }; f"
    update = "!f() { git checkout $1 && git pull origin $1 && git checkout - && git rebase $1; }; f"

[core]
	excludesfile = /Users/alexdickson3/.gitignore
    attributesfile = /Users/alexdickson3/.gitattributes_global
	pager = delta


[push]
    autoSetupRemote = true

[user]
	email = alexdicksonroig@gmail.com
	name = alexdicksonroig
